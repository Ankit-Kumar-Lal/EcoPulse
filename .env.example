# EcoPulse Environment Configuration
# Copy this file to .env and configure the values appropriately.

# PostgreSQL URLs: pooled for the app, direct for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Session authentication secret (minimum 32 characters for HMAC SHA-256 signing)
AUTH_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"

# Public application base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Environment (development, test, production)
NODE_ENV="development"

# Support Contact Email (as per EcoPulse specification)
SUPPORT_EMAIL="ankitkumarlal2006@gmail.com"
