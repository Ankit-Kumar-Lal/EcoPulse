# EcoPulse Environment Configuration
# Copy this file to .env and configure the values appropriately.

# Database connection string (SQLite for local file-based persistence or PostgreSQL URL)
DATABASE_URL="file:./dev.db"

# Session authentication secret (minimum 32 characters for HMAC SHA-256 signing)
AUTH_SECRET="ecopulse-production-secure-auth-secret-key-2026-v1"

# Public application base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Environment (development, test, production)
NODE_ENV="development"

# Support Contact Email (as per EcoPulse specification)
SUPPORT_EMAIL="ankitkumarlal2006@gmail.com"
